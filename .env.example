# Copia este archivo como .env.local (ignorado por git) solo si el backend no está en el valor por defecto.
# Origen del backend (sin /api/v1). Valor por defecto: http://localhost:8080
VITE_API_BASE_URL=http://localhost:8080

# Iniciar sesión con Google: el mismo ID de cliente OAuth que GOOGLE_CLIENT_ID del backend
# (README del backend, "Sign in with Google"). Vacío = el botón de Google no se muestra.
VITE_GOOGLE_CLIENT_ID=

# Copia este archivo como .env.local (ignorado por git) solo si cambias algún valor por defecto.

# Gateway al que el servidor de desarrollo de Vite reenvía /api. Valor por defecto:
# http://localhost:8080. La web siempre llama a /api en su propio origen, así las cookies
# HttpOnly de la sesión funcionan sin CORS (en Docker lo hace nginx).
# VITE_DEV_API_TARGET=http://localhost:8080

# Iniciar sesión con Google: el mismo ID de cliente OAuth que GOOGLE_CLIENT_ID del servicio de
# seguridad. Vacío = el botón de Google no se muestra.
VITE_GOOGLE_CLIENT_ID=
